# Copy to .env and fill in. Only FACILITATOR_PRIVATE_KEY is required.


# ── Core ────────────────────────────────────────────────────────────────────

# Pays gas on both networks, so there is one address to fund. A hot wallet: it
# signs transactions. It cannot move customer funds — an `exact` payment's
# recipient and amount are fixed in the payer's own signature.
#
# On Arc, gas is USDC, so funding this address means sending it USDC. Testnet
# USDC comes from https://faucet.circle.com.
FACILITATOR_PRIVATE_KEY=

# Optional. Postgres (Neon or any) for the public payment log; tables are
# created on first use. Without it, payments still settle and /logs stays empty.
DATABASE_URL=


# ── Networks ────────────────────────────────────────────────────────────────

# Mainnet spends real USDC, so it is off until deliberately enabled. While off,
# /verify still works and /settle returns 503.
#
# This is a live switch: Arc mainnet USDC implements EIP-3009 and is allowlisted
# in lib/networks.ts, so flipping this to true starts settling real payments as
# soon as the signer is funded. Nothing else gates it.
MAINNET_ENABLED=false

# Defaults are Circle's primary public endpoints, which take anonymous requests
# with open CORS. They are load-balanced across backends at slightly different
# heights, so a read at the chain head can return -32014; retry after a short
# backoff. Alchemy, Blockdaemon, dRPC and QuickNode also serve Arc.
RPC_URL_TESTNET=https://rpc.testnet.arc.io
RPC_URL_MAINNET=https://rpc.mainnet.arc.io


# ── Site ────────────────────────────────────────────────────────────────────

# Public origin. Appears in the docs' copy-paste snippets.
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:3000

# Which network the site opens on: testnet | mainnet
NEXT_PUBLIC_DEFAULT_NETWORK=testnet


# ── Guards (defaults shown) ─────────────────────────────────────────────────

# Dust floor, in 6-decimal base units. 10000 = 0.01 USDC. Below this, gas
# exceeds the transfer: a settle costs ~0.0017-0.0022 USDC (70-90k gas at Arc's
# 20 Gwei minimum base fee), which on Arc is directly comparable because the
# gas and the payment are the same asset.
MIN_AMOUNT_BASE_UNITS=10000

# Per-settlement ceiling. An EIP-3009 transfer uses 70-90k.
MAX_SETTLE_GAS=300000

# Below this balance, /settle returns 503 instead of broadcasting into failure.
# In USDC, read from the signer's native (18-decimal) balance — the same money
# an ERC-20 balanceOf shows at 6 decimals. 0.05 USDC is roughly 25 settles.
MIN_SIGNER_BALANCE_USDC=0.05

# Requests per 60-second window. In-process counters — single instance only.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_PAYER_PER_MIN=30
RATE_LIMIT_PAYTO_PER_MIN=120
RATE_LIMIT_GLOBAL_PER_MIN=1200


# ── Bazaar ──────────────────────────────────────────────────────────────────

# Development escape hatch. When true, /discovery/register will fetch private,
# loopback and link-local targets, which the SSRF guard otherwise refuses.
# Never set this in a deployment that accepts registrations from the internet.
BAZAAR_ALLOW_PRIVATE_TARGETS=false


# ── pnpm smoke only ─────────────────────────────────────────────────────────

# An account holding USDC. It needs no separate gas balance — on Arc there is
# no such thing, since gas is USDC — and it must differ from SMOKE_PAY_TO.
#
# The test asserts this account's native balance falls by exactly the authorized
# amount and not one wei more. That is the whole proof: any gas charged to the
# payer would show up in that difference.
SMOKE_PAYER_PRIVATE_KEY=

# Where the test payment lands. An address you control, not the payer's.
SMOKE_PAY_TO=
